# Helgrind suppressions for GoogleTest runner and C++ standard library runtime internals

{
   helgrind_gtest_all_races
   Helgrind:Race
   ...
   fun:*testing*
}

{
   helgrind_gtest_all_lockorder
   Helgrind:LockOrder
   ...
   fun:*testing*
}

{
   helgrind_gtest_misc
   Helgrind:Misc
   ...
   fun:*testing*
}

{
   helgrind_std_thread
   Helgrind:Race
   ...
   fun:*std*thread*
}

{
   helgrind_std_call_once
   Helgrind:Race
   ...
   fun:*call_once*
}

{
   helgrind_std_future
   Helgrind:Race
   ...
   fun:*std*future*
}
